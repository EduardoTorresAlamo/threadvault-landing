---
import { copy, type Lang } from "../i18n/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].how;
---

<section id="how" class="scroll-mt-24 border-t border-white/[0.07] py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="heading mt-3 text-3xl font-semibold text-white sm:text-5xl">{t.title}</h2>
    </div>

    <ol class="mt-14 grid gap-4 sm:grid-cols-3">
      {
        t.steps.map((step, index) => (
          <li class="panel p-6 sm:p-7" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold-300 font-mono text-[0.8rem] font-semibold tabular-nums text-vault">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="heading mt-6 text-xl font-semibold text-white">{step.title}</h3>
            <p class="lede mt-2 leading-relaxed text-neutral-400">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
