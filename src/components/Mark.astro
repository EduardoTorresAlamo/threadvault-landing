---
interface Props {
  class?: string;
}

const { class: className = "h-6 w-6" } = Astro.props;
---

<!-- The app icon's layered card stack, reduced to a glyph. -->
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="5" y="2.5" width="14" height="4" rx="2" fill="currentColor" opacity="0.3"></rect>
  <rect x="3.25" y="8" width="17.5" height="4.5" rx="2.25" fill="currentColor" opacity="0.6"></rect>
  <rect x="1.75" y="14" width="20.5" height="7.5" rx="3" fill="currentColor"></rect>
</svg>
