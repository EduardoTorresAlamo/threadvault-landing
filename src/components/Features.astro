---
import { copy, type Lang } from "../i18n/copy";
import ScreenshotFrame from "./ScreenshotFrame.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].features;

const icons = [
  // Summary and category: a document with a check.
  "M7 4h7l4 4v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm7 0v4h4M9 14l2 2 4-4",
  // Tags and filter: a label.
  "M4 10.8V5.5A1.5 1.5 0 0 1 5.5 4h5.3a1.5 1.5 0 0 1 1.06.44l7 7a1.5 1.5 0 0 1 0 2.12l-5.3 5.3a1.5 1.5 0 0 1-2.12 0l-7-7A1.5 1.5 0 0 1 4 10.8Zm4-3.3h.01",
  // Search, semantic included: a lens that also catches what sits beside the query.
  "M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm4.9 11.4L20 20M18.5 6.5h.01",
  // Reader and embeds: an open book.
  "M4 5.5c2-1 4.5-1 6.5 0v13c-2-1-4.5-1-6.5 0v-13Zm16 0c-2-1-4.5-1-6.5 0v13c2-1 4.5-1 6.5 0v-13Z",
];

const moreIcons = [
  // Widget: a rounded tile with a picture area.
  "M5 4h14a1.5 1.5 0 0 1 1.5 1.5v13A1.5 1.5 0 0 1 19 20H5a1.5 1.5 0 0 1-1.5-1.5v-13A1.5 1.5 0 0 1 5 4Zm-1.5 9h17M8 16.5h4",
  // Siri and Shortcuts: a speech bubble.
  "M5 5h14a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 19 16h-6l-4 3.5V16H5a1.5 1.5 0 0 1-1.5-1.5v-8A1.5 1.5 0 0 1 5 5Zm4 5.5h6",
  // Images: a photo frame.
  "M5 4h14a1.5 1.5 0 0 1 1.5 1.5v13A1.5 1.5 0 0 1 19 20H5a1.5 1.5 0 0 1-1.5-1.5v-13A1.5 1.5 0 0 1 5 4Zm-1.5 12 5-5 4 4 2.5-2.5 5.5 5.5M15.5 8.5h.01",
];

const iconWrap =
  "inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-gold-300/20 bg-gold-300/10 text-gold-300";
---

<section id="features" class="scroll-mt-24 border-t border-white/[0.07] py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="heading mt-3 text-3xl font-semibold text-white sm:text-5xl">{t.title}</h2>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {
        t.items.map((item, index) => (
          <article
            class="panel overflow-hidden transition-colors duration-200 hover:border-white/[0.14]"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <!-- The stage: the icon's gradient, so each phone sits in the same light. -->
            <div
              class="px-6 pt-9 pb-8"
              style="background: radial-gradient(70% 70% at 50% 0%, color-mix(in oklab, var(--color-gold-300) 9%, transparent), transparent 75%), linear-gradient(to bottom, color-mix(in oklab, var(--color-white) 3%, transparent), transparent);"
            >
              <ScreenshotFrame name={item.screenshot} alt={`ThreadVault: ${item.title}`} />
            </div>

            <div class="border-t border-white/[0.07] p-6 sm:p-7">
              <span class={iconWrap}>
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[index]} />
                </svg>
              </span>

              <h3 class="heading mt-5 text-xl font-semibold text-white">{item.title}</h3>
              <p class="lede mt-2 leading-relaxed text-neutral-400">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="eyebrow mt-16" data-reveal>{t.moreTitle}</h3>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {
        t.more.map((item, index) => (
          <div
            class="vault-card flex gap-4 p-5"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <span class={iconWrap}>
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={moreIcons[index]} />
              </svg>
            </span>
            <div>
              <h4 class="text-sm font-semibold text-white">{item.title}</h4>
              <p class="lede mt-1.5 text-sm leading-relaxed text-neutral-400">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
