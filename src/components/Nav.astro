---
import { copy, languages, pathFor, type Lang } from "../i18n/copy";
import Mark from "./Mark.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].nav;

const links = [
  { href: "#features", label: t.features },
  { href: "#how", label: t.how },
  { href: "#faq", label: t.faq },
  { href: "#pricing", label: t.pricing },
];
---

<header class="fixed inset-x-0 top-0 z-40">
  <!-- Translucent chrome with content passing underneath, and a fade at the edge
       instead of a hard 1px rule. -->
  <div
    class="border-b border-white/[0.06] bg-slate-950/60 backdrop-blur-xl backdrop-saturate-150 supports-[backdrop-filter]:bg-slate-950/50"
  >
    <nav
      class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8"
      aria-label={lang === "es" ? "Principal" : "Primary"}
    >
      <a
        href={pathFor(lang)}
        class="pressable flex items-center gap-2.5 text-slate-100 hover:text-white"
      >
        <Mark class="h-5 w-5 text-gold-300" />
        <span class="text-[0.95rem] font-semibold tracking-tight">ThreadVault</span>
      </a>

      <ul class="ml-auto hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="pressable rounded-full px-3 py-1.5 text-sm text-slate-400 hover:bg-white/5 hover:text-slate-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="ml-auto flex items-center gap-0.5 rounded-full border border-white/[0.08] bg-white/[0.03] p-0.5 md:ml-0"
        role="group"
        aria-label={t.langLabel}
      >
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={pathFor(code)}
              aria-current={code === lang ? "page" : undefined}
              class:list={[
                "pressable rounded-full px-2.5 py-1 text-xs font-medium uppercase tracking-wide",
                code === lang
                  ? "bg-white/10 text-white"
                  : "text-slate-400 hover:text-slate-200",
              ]}
            >
              {code}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>
