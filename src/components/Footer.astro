---
import { copy, pathFor, type Lang } from "../i18n/copy";
import Mark from "./Mark.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const year = new Date().getFullYear();
const home = pathFor(lang);

const links = [
  { href: `${home}#features`, label: t.nav.features },
  { href: `${home}#how`, label: t.nav.how },
  { href: `${home}#faq`, label: t.nav.faq },
];

const policyHref = lang === "es" ? "/privacidad/" : "/en/privacy/";
const linkClass = "pressable text-neutral-400 hover:text-white";
---

<footer class="border-t border-white/[0.07] py-14">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-16">
      <div>
        <a href={home} class="pressable inline-flex items-center gap-2.5 text-neutral-100 hover:text-white">
          <Mark class="h-5 w-5 text-gold-300" />
          <span class="text-[0.95rem] font-semibold tracking-tight">ThreadVault</span>
        </a>
        <p class="lede mt-3 max-w-sm text-sm leading-relaxed text-neutral-400">{t.footer.tagline}</p>

        <span
          class="mt-6 inline-flex items-center gap-2 rounded-xl border border-white/[0.12] bg-vault-card px-4 py-2 text-sm font-medium text-white"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.8-3.6 2.1-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.2 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.1 0 1.9-1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.5-.1 0-2.2-.9-2.2-3.2zM14.2 5.9c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.7-.9 2.6 1 .1 2-.5 2.6-1.2z"></path>
          </svg>
          {t.hero.ctaPrimary}
        </span>
      </div>

      <nav class="text-sm" aria-label={lang === "es" ? "Pie de página" : "Footer"}>
        <ul class="space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a class={linkClass} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class={linkClass} href={policyHref}>{t.footer.privacyLink}</a>
          </li>
          <li>
            <a class={linkClass} href="mailto:torreseduardo804@gmail.com?subject=ThreadVault">
              {t.footer.contact}
            </a>
          </li>
          <li>
            <a
              class={linkClass}
              href={pathFor(lang === "es" ? "en" : "es")}
              hreflang={lang === "es" ? "en" : "es"}
            >
              {lang === "es" ? "English" : "Español"}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-white/[0.07] pt-6 text-xs text-neutral-400">
      © {year} Eduardo Torres · {t.footer.rights}
    </p>
  </div>
</footer>
