---
/**
 * Abstract stand-in for the app's VaultCard (Views/VaultCard.swift): #161616 fill,
 * 18pt continuous corners, 1px white 7% stroke, a tinted media band, a title and
 * one mono metadata line led by a category dot. Built from shapes only, never
 * text, so it can't be mistaken for a real capture.
 */
interface Props {
  /** Category accent, hex. Tints the media band and the dot, like categoryAccentColor. */
  tint?: string;
  /** Tailwind height class for the media band. */
  media?: string;
  /** Number of title bars (1 to 3). */
  lines?: number;
  /** Corner radius in px; the app uses 18 at full size. */
  radius?: number;
  /** Show a capsule over the media band (reading time badge in the app). */
  badge?: boolean;
  class?: string;
}

const {
  tint = "#7eb8f7",
  media = "h-16",
  lines = 2,
  radius = 12,
  badge = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["vault-card", className]}
  style={`border-radius:${radius}px`}
  aria-hidden="true"
>
  <div class={`relative ${media}`} style={`background:linear-gradient(160deg, ${tint}22, ${tint}0d)`}>
    <span
      class="absolute left-1/2 top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-md border"
      style={`border-color:${tint}80`}></span>
    {
      badge && (
        <span class="absolute bottom-1.5 left-1.5 h-2.5 w-6 rounded-full bg-white/20" />
      )
    }
    <span class="absolute inset-x-0 bottom-0 h-px bg-white/[0.07]"></span>
  </div>
  <div class="space-y-1.5 px-2.5 pb-2.5 pt-2">
    <span class="block h-1.5 w-11/12 rounded-full bg-white/80"></span>
    {lines > 1 && <span class="block h-1.5 w-3/4 rounded-full bg-white/80"></span>}
    {lines > 2 && <span class="block h-1.5 w-1/2 rounded-full bg-white/80"></span>}
    <span class="flex items-center gap-1 pt-0.5">
      <span class="h-1.5 w-1.5 rounded-full" style={`background:${tint}`}></span>
      <span class="h-1 w-8 rounded-full bg-white/[0.35]"></span>
      <span class="h-1 w-1 rounded-full bg-white/20"></span>
      <span class="h-1 w-6 rounded-full bg-white/[0.35]"></span>
    </span>
  </div>
</div>
