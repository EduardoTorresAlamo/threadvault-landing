---
import MockCard from "./MockCard.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Astro's i18n routing (astro.config.mjs: defaultLocale "es", locales
// ["es", "en"]) resolves this per page even though the component itself
// takes no lang prop, so the accessible name still matches each page's
// language without widening this component's contract beyond `class`.
const locale = Astro.currentLocale ?? "es";

const ariaLabel =
  locale === "en"
    ? "Illustration of ThreadVault's stack of saved cards, with a category dot and tag chips floating beside it"
    : "Ilustración de la pila de tarjetas guardadas de ThreadVault, con un punto de categoría y chips de etiqueta alrededor";
---

<!--
  Redraw of the app icon (scripts/render-app-icon.swift in the app source), in the
  same 220-unit design space: a radial gradient #1a1a1a -> #0A0A0A, and three
  gold-stroked cards fanned at -9, 3 and -2 degrees with two "text" lines on the
  front one. Around it float abstract fragments of the app UI (a card, a selected
  tag chip), drawn as shapes only: nothing here claims to be a real capture.
-->
<div class:list={["relative", className]} role="img" aria-label={ariaLabel}>
  <!-- Warm bloom behind the tile, the icon's gold at low strength. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -inset-[18%] -z-10"
    style="background: radial-gradient(closest-side, color-mix(in oklab, var(--color-gold-400) 22%, transparent), transparent 72%);"
  >
  </div>

  <svg
    viewBox="0 0 220 220"
    class="h-auto w-full drop-shadow-[0_40px_60px_rgba(0,0,0,0.7)]"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <radialGradient id="tv-bg" cx="0.3" cy="0.15" r="1.2">
        <stop offset="0" stop-color="#1a1a1a"></stop>
        <stop offset="0.5" stop-color="#0a0a0a"></stop>
      </radialGradient>
      <linearGradient id="tv-front" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#232323"></stop>
        <stop offset="1" stop-color="#181818"></stop>
      </linearGradient>
      <filter id="tv-shadow" x="-20%" y="-20%" width="140%" height="150%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000" flood-opacity="0.45"
        ></feDropShadow>
      </filter>
    </defs>

    <rect width="220" height="220" rx="49" fill="url(#tv-bg)"></rect>
    <rect
      x="0.5"
      y="0.5"
      width="219"
      height="219"
      rx="48.5"
      fill="none"
      stroke="#ffffff"
      stroke-opacity="0.08"></rect>

    <g transform="rotate(-9 110 126)">
      <rect x="44" y="78" width="132" height="96" rx="16" fill="#161616" stroke="#e8d5a3" stroke-opacity="0.35" stroke-width="2"
      ></rect>
    </g>
    <g transform="rotate(3 110 114)">
      <rect x="44" y="66" width="132" height="96" rx="16" fill="#1c1c1c" stroke="#e8d5a3" stroke-opacity="0.55" stroke-width="2"
      ></rect>
    </g>
    <g transform="rotate(-2 110 104)">
      <rect x="44" y="56" width="132" height="96" rx="16" fill="url(#tv-front)" stroke="#e8d5a3" stroke-width="2.5" filter="url(#tv-shadow)"
      ></rect>
      <rect x="66" y="80" width="88" height="6" rx="3" fill="#e8d5a3" fill-opacity="0.8"></rect>
      <rect x="66" y="94" width="60" height="6" rx="3" fill="#e8d5a3" fill-opacity="0.4"></rect>
    </g>
  </svg>

  <!-- Floating fragments of the app UI. -->
  <div
    aria-hidden="true"
    class="stack-card absolute -right-[6%] top-[8%] hidden w-[34%] sm:block"
    style="--r: 4deg; --r-from: 8deg; --d: 250ms"
  >
    <MockCard tint="#7eb8f7" media="h-14" lines={2} radius={14} class="shadow-[0_24px_40px_-18px_rgba(0,0,0,0.9)]" />
  </div>

  <div
    aria-hidden="true"
    class="stack-card absolute -left-[5%] bottom-[10%] flex items-center gap-1.5"
    style="--r: -3deg; --r-from: -7deg; --d: 400ms"
  >
    <span class="inline-flex h-7 items-center gap-1.5 rounded-full bg-gold-300 px-3 shadow-[0_12px_30px_-10px_rgba(232,213,163,0.55)]">
      <span class="h-1.5 w-9 rounded-full bg-vault/80"></span>
      <span class="h-1.5 w-2 rounded-full bg-vault/40"></span>
    </span>
    <span class="hidden h-7 items-center gap-1.5 rounded-full border border-white/[0.12] bg-vault-card px-3 sm:inline-flex">
      <span class="h-1.5 w-8 rounded-full bg-white/60"></span>
    </span>
  </div>
</div>
