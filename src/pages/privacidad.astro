---
import Layout from "../layouts/Layout.astro";
import { copy } from "../i18n/copy";

const lang = "es" as const;
const t = copy[lang].meta.privacyPage;

const sections = [
  {
    title: "Clasificación con IA",
    body: "Corre en tu iPhone con Apple Intelligence. Lo que guardas nunca se envía a un modelo por internet, bajo ninguna configuración. Si tu dispositivo no es compatible, ThreadVault sigue guardando y buscando, solo sin resumen, categoría ni etiquetas.",
  },
  {
    title: "La página que compartiste",
    body: "Para mostrar el título y la vista previa, ThreadVault descarga la página que guardaste, igual que hace tu navegador. Solo HTTPS, sin cookies, sin sesión que persista y con límites de tamaño en la respuesta. Esa descarga tiene una consecuencia: el sitio que guardaste se entera de que alguien en tu dirección IP lo guardó. Con Reddit se hacen dos peticiones por publicación, ambas al propio Reddit.",
  },
  {
    title: "Búsquedas oEmbed",
    body: "Cuando una página no trae vista previa propia, ThreadVault consulta el endpoint público de oEmbed de TikTok, YouTube, Reddit o X. Sin token, sin cuenta.",
  },
  {
    title: "Enlaces cortos",
    body: "Para expandir un enlace corto (por ejemplo de TikTok o Reddit) y encontrar la publicación real, ThreadVault hace una única petición HEAD. Solo HTTPS, sin cookies, y el resultado solo se usa si es una publicación de una plataforma compatible.",
  },
  {
    title: "Publicaciones incrustadas",
    body: "Al abrir el detalle de una publicación guardada de YouTube, TikTok, Instagram, Threads, Reddit, X o Facebook, ThreadVault carga el reproductor de esa plataforma dentro de una vista web aislada. Las cookies no persisten entre sesiones, la reproducción automática está desactivada y solo cruza un canal de mensajes hacia la app.",
  },
  {
    title: "Búsqueda semántica",
    body: "Viene desactivada. Si la activas, Apple descarga una vez su modelo de embeddings desde sus propios servidores. Después, todo el cálculo ocurre en tu teléfono y las consultas nunca se envían a ningún sitio.",
  },
  {
    title: "Lo que nunca sale",
    body: "Tus resúmenes, categorías, etiquetas, texto de artículos e imágenes guardadas viven solo en tu iPhone. La extensión de compartir y el widget no hacen ninguna petición de red.",
  },
];
---

<Layout lang={lang} title={t.title} description={t.description}>
  <article class="mx-auto max-w-2xl px-5 py-32 sm:px-8 sm:py-40">
    <p class="eyebrow">{copy[lang].privacy.eyebrow}</p>
    <h1 class="display mt-3 text-4xl font-semibold text-white sm:text-5xl">Privacidad</h1>

    <p class="lede mt-6 text-lg leading-relaxed text-neutral-300">
      ThreadVault no tiene servidor, ni cuentas, ni analítica, ni publicidad. Esto es exactamente
      lo que la app puede enviar por la red.
    </p>

    <div class="vault-card mt-10 divide-y divide-white/[0.07]" style="border-radius:22px">
      {
        sections.map((section) => (
          <section class="p-6 sm:p-8">
            <h2 class="heading text-lg font-semibold text-white">{section.title}</h2>
            <p class="lede mt-2.5 leading-relaxed text-neutral-400">{section.body}</p>
          </section>
        ))
      }
    </div>

    <p class="lede mt-10 text-sm text-neutral-400">
      ¿Preguntas? Escríbeme a <a
        class="pressable text-gold-300 underline-offset-4 hover:text-gold-200 hover:underline"
        href="mailto:torreseduardo804@gmail.com?subject=ThreadVault">torreseduardo804@gmail.com</a
      >.
    </p>
  </article>
</Layout>
